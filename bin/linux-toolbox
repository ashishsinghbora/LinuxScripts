#!/usr/bin/env bash
# linux-toolbox – CLI dispatcher and interactive menu for LinuxScripts toolkit.
set -euo pipefail

show_help() {
  cat <<'EOF'
Usage: linux-toolbox [options] [command] [args...]

Commands:
  list                          List all available utility categories and scripts
  run <script_name> [args...]   Directly run a utility script (e.g. developer/command-exists bash)
  <script_name> [args...]       Shortcut to directly run a utility script

Options:
  -h, --help                    Show this help message and exit

Description:
  When launched without arguments, opens an interactive keyboard menu
  to explore and run scripts from the LinuxScripts repository.
EOF
  exit 0
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
SCRIPTS_DIR="$REPO_ROOT/scripts"

declare -A CATEGORY_MAP=(
  [1]="system"
  [2]="storage"
  [3]="network"
  [4]="process"
  [5]="packages"
  [6]="hardware"
  [7]="ssh"
  [8]="developer"
  [9]="maintenance"
)

list_all_scripts() {
  echo "=== Available LinuxScripts Utilities ==="
  echo ""
  for idx in $(echo "${!CATEGORY_MAP[@]}" | tr ' ' '\n' | sort -n); do
    cat_name="${CATEGORY_MAP[$idx]}"
    cat_dir="$SCRIPTS_DIR/$cat_name"
    echo "[$cat_name]"
    if [[ -d "$cat_dir" ]]; then
      for s in "$cat_dir"/*.sh; do
        if [[ -f "$s" ]]; then
          s_name="$(basename "$s" .sh)"
          echo "  - $cat_name/$s_name"
        fi
      done
    fi
    echo ""
  done
}

find_script() {
  local query="$1"
  # Strip .sh if user passed it
  query="${query%.sh}"

  # 1. Exact match category/script
  if [[ -f "$SCRIPTS_DIR/$query.sh" ]]; then
    echo "$SCRIPTS_DIR/$query.sh"
    return 0
  fi

  # 2. Search by script basename across categories
  local matches=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && matches+=("$f")
  done < <(find "$SCRIPTS_DIR" -maxdepth 2 -type f -name "$query.sh" 2>/dev/null || true)

  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return 0
  elif [[ ${#matches[@]} -gt 1 ]]; then
    echo "Ambiguous script name '$query'. Please specify category: e.g. '${matches[0]#"$SCRIPTS_DIR/"}'" >&2
    return 1
  fi

  return 1
}

run_script_cli() {
  local target="$1"
  shift
  local script_path
  if ! script_path="$(find_script "$target")"; then
    echo "Error: Utility script '$target' not found." >&2
    echo "Run 'linux-toolbox list' to view available scripts." >&2
    exit 1
  fi

  exec "$script_path" "$@"
}

# CLI argument handling
if [[ $# -gt 0 ]]; then
  case "$1" in
    -h|--help)
      show_help
      ;;
    list)
      list_all_scripts
      exit 0
      ;;
    run)
      shift
      if [[ $# -lt 1 ]]; then
        echo "Error: Script name required for 'run' command." >&2
        echo "Usage: linux-toolbox run <script_name> [args...]" >&2
        exit 1
      fi
      run_script_cli "$@"
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      show_help
      ;;
    *)
      run_script_cli "$@"
      ;;
  esac
fi

# Interactive Menu Mode
main_menu() {
  echo ""
  echo "=============================="
  echo "   Linux Toolbox Main Menu    "
  echo "=============================="
  echo " 1) System"
  echo " 2) Storage"
  echo " 3) Network"
  echo " 4) Processes"
  echo " 5) Packages"
  echo " 6) Hardware"
  echo " 7) SSH"
  echo " 8) Developer"
  echo " 9) Maintenance"
  echo "10) Exit"
  echo "------------------------------"
  read -rp "Select a category [1-10]: " cat_choice

  case "$cat_choice" in
    10)
      echo "Exiting Linux Toolbox. Goodbye!"
      exit 0
      ;;
    [1-9])
      sub_menu "${CATEGORY_MAP[$cat_choice]}"
      ;;
    *)
      echo "Invalid selection. Please choose a number between 1 and 10."
      main_menu
      ;;
  esac
}

sub_menu() {
  local category="$1"
  local dir="$SCRIPTS_DIR/$category"

  if [[ ! -d "$dir" ]]; then
    echo "Category directory not found: $dir"
    main_menu
    return
  fi

  mapfile -t scripts < <(find "$dir" -maxdepth 1 -type f -name "*.sh" | sort)
  if [[ ${#scripts[@]} -eq 0 ]]; then
    echo "No scripts found in $category."
    main_menu
    return
  fi

  echo ""
  echo "------------------------------"
  echo " Category: $category"
  echo "------------------------------"
  for i in "${!scripts[@]}"; do
    printf "%2d) %s\n" $((i+1)) "$(basename "${scripts[$i]}")"
  done
  echo " 0) Back to main menu"
  echo "------------------------------"
  read -rp "Select a script [0-${#scripts[@]}]: " script_choice

  if [[ "$script_choice" =~ ^[0-9]+$ ]]; then
    if [[ "$script_choice" -eq 0 ]]; then
      main_menu
      return
    elif (( script_choice >= 1 && script_choice <= ${#scripts[@]} )); then
      local selected_script="${scripts[$((script_choice-1))]}"
      echo ""
      echo "Running $(basename "$selected_script")..."
      read -rp "Enter arguments for the script (press Enter for none): " extra_args
      echo ""

      if [[ -n "$extra_args" ]]; then
        read -ra arg_arr <<< "$extra_args"
        "$selected_script" "${arg_arr[@]}" || echo "Script exited with non-zero status ($?)"
      else
        "$selected_script" || echo "Script exited with non-zero status ($?)"
      fi

      echo ""
      read -rp "Press Enter to return to $category menu..." _
      sub_menu "$category"
      return
    fi
  fi

  echo "Invalid choice. Please enter a valid number."
  sub_menu "$category"
}

main_menu
